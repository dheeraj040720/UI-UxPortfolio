# Browser-safe Supabase keys (prefix VITE_ exposes them to the React bundle)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Server-only secrets (set in Vercel Environment Variables ONLY — never in client code)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Optional Notification Provider (set EITHER Resend OR Telegram, or leave blank to disable)
RESEND_API_KEY=
ALERT_EMAIL_TO=
ALERT_EMAIL_FROM=

TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
